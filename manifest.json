{
  "manifest_version": 3,
  "name": "Ro'eh — Link Safety",
  "version": "1.1.0",
  "description": "Highlights link warning signs on the pages you visit. Informational only; not a malware scanner.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["link-analyzer.js", "content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ro'eh link safety"
  }
}
